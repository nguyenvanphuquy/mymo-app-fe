# Copy to `.env` and restart Expo when you change this file.
#
# Web / simulator on same PC (default in dev if unset):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5079
#
# Phone on same Wi‑Fi (replace with your PC IP from `ipconfig`):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5079
#
# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5079
#
# Production build (Netlify — set in site env vars, not in repo):
# EXPO_PUBLIC_API_BASE_URL=https://beexe-production.up.railway.app
